# BillionMail API — set these to send invite emails (no SMTP needed)
BILLIONMAIL_API_URL=https://mail.datacultr.cloud
BILLIONMAIL_INVITE_API_KEY=your-api-key-here
BILLIONMAIL_TLS_INSECURE=true
BILLIONMAIL_FROM=

# Leave empty to use same-origin /api (recommended — Vite proxies to backend)
VITE_API_URL=
VITE_API_PROXY=http://backend:3002

# App URLs
APP_URL=https://jira.slj15.com

# CORS (optional — only needed if frontend calls backend on a different domain)
# CORS_ORIGIN=https://jira.slj15.com

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Slack (optional)
SLACK_WEBHOOK_URL=

# Default admin (created on first database seed)
ADMIN_EMAIL=admin@ticketing.local
ADMIN_PASSWORD=change-me-in-production
ADMIN_NAME=Admin User

# Additional super admins — run: docker-compose exec backend npm run db:create-admins
# ADMIN_USERS=alice@company.com:Alice,bob@company.com:Bob Smith
# REQUIRE_PASSWORD_CHANGE=true  # force existing admins to set a new password on next login

# SMTP fallback — only used if BillionMail API is not configured above
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
